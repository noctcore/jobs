---
/** The few exports a first queue needs, and where to go next. */
const ENTRIES = [
  { name: 'defineQueue', what: 'A queue, its typed jobs and its policy, in one file both sides import.' },
  { name: 'JobsModule', what: 'forRoot or forRootAsync once, forFeature where the queues are used.' },
  { name: 'queue.add', what: 'Typed by the queue, with a required dedupe, bounded by the producer timeout.' },
  { name: '@Worker + JobHost', what: 'One worker class per queue: handle, onFinalFailure, classify, pauseQueue.' },
  { name: '@Sweep', what: 'A method on a schedule, once per tick across every replica.' },
  { name: 'installGracefulShutdown', what: 'Drains workers before the app closes, then flushes telemetry.' },
];
---

<section class="nc-section nc-packages not-content" aria-labelledby="nc-packages-title">
  <h2 id="nc-packages-title">Six things to learn</h2>
  <ul class="nc-packages__list">
    {
      ENTRIES.map((entry) => (
        <li>
          <code>{entry.name}</code>
          <span>{entry.what}</span>
        </li>
      ))
    }
  </ul>
  <div class="nc-next">
    <a class="nc-next__link" href="/jobs/start/getting-started/">
      <span class="nc-next__label">Start</span>
      <span class="nc-next__title">Define a queue and process it</span>
    </a>
    <a class="nc-next__link" href="/jobs/migrating/nestjs-bullmq/">
      <span class="nc-next__label">Migrate</span>
      <span class="nc-next__title">Move over from @nestjs/bullmq</span>
    </a>
  </div>
</section>
