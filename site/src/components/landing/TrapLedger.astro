---
/**
 * The traps, drawn in the brand's line language: one track through the rows,
 * and each trap comes in from the side and stops at the part of the package
 * that closes it.
 */
import { TRAPS } from './traps';
---

<section class="nc-band not-content" aria-labelledby="nc-run-title">
  <div class="nc-band__inner">
    <div class="nc-section__head">
      <h2 id="nc-run-title">The traps, closed by default.</h2>
      <p>
        Most BullMQ incidents are not bugs in BullMQ but defaults left unchanged. Each row is one of
        them and the part of the package that closes it, with a link to the page that explains how.
      </p>
    </div>
    <ol class="nc-passage">
      {
        TRAPS.map((row) => (
          <li class="nc-passage__step">
            <a href={row.href} class="nc-passage__link">
              <span class="nc-passage__failure">
                <span class="nc-passage__label">Trap</span>
                {row.failure}
              </span>
              <span class="nc-passage__node" aria-hidden="true">
                <span class="nc-passage__wire">
                  <span class="nc-passage__dash" />
                </span>
                <span class="nc-passage__stop" />
              </span>
              <span class="nc-passage__answer">
                <code class="nc-passage__module">{row.module}</code>
                {row.answer}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>
