{
  "name": "@noctcore/jobs-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/changelog.ts && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "docs:build": "bun scripts/changelog.ts && ASTRO_TELEMETRY_DISABLED=1 astro build && bun scripts/check-build.ts",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "typecheck": "bun scripts/changelog.ts && ASTRO_TELEMETRY_DISABLED=1 astro sync && tsc --noEmit && tsc -p snippets",
    "test": "bun test scripts"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.8",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "astro": "^7.4.5",
    "satteri": "^0.11.6",
    "starlight-typedoc": "0.23.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1"
  },
  "devDependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@noctcore/jobs": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "@sentry/node": "10.32.1",
    "@types/bun": "^1.4.4",
    "@types/node": "22.20.5",
    "bullmq": "6.7.6",
    "ioredis": "5.11.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "^5.9.3"
  }
}
