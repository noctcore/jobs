{
  "name": "@noctcore/jobs",
  "version": "0.1.0",
  "description": "BullMQ for NestJS with safe defaults: required retry and retention policies, required dedupe keys, fail-fast producers, one-run-per-tick sweeps and graceful shutdown.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "noctcore",
    "bullmq",
    "nestjs",
    "nest",
    "queue",
    "jobs",
    "background-jobs",
    "redis",
    "cron",
    "scheduler"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noctcore/jobs.git",
    "directory": "packages/jobs"
  },
  "homepage": "https://noctcore.github.io/jobs/",
  "bugs": "https://github.com/noctcore/jobs/issues",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11.0.0 <13",
    "@nestjs/core": ">=11.0.0 <13",
    "bullmq": ">=6.3.0 <7",
    "ioredis": ">=5.4.0 <7"
  },
  "devDependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/testing": "12.5.1",
    "@types/node": "^22.20.5",
    "bullmq": "6.7.6",
    "ioredis": "5.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
